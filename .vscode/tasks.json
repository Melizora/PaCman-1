{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Pacman avec SDL2",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "gcc main.c src/barrieres.c -o pacman -I/opt/homebrew/include/SDL2 -L/opt/homebrew/lib -lSDL2 -lSDL2_image"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "C/C++: clang générer le fichier actif",
            "command": "bash",
            "args": [
                "-c",
                "gcc main.c src/barrieres.c -o pacman -I/opt/homebrew/include/SDL2 -L/opt/homebrew/lib -lSDL2 -lSDL2_image"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Tâche générée par le débogueur."
        },
        {
            "type": "cmake",
            "label": "CMake: build",
            "command": "build",
            "targets": [
                "all"
            ],
            "group": "build",
            "problemMatcher": [],
            "detail": "Tâche build de modèle CMake"
        }
    ]
}